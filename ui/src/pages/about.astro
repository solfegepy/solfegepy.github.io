---
import { CodecApp } from "../components/pages/CodecApp";
import Layout from "../layouts/Layout.astro";

const title = "About Codec64";
const description = "Who makes Codec64, the browser-only encoding and conversion tools, and how to get in touch.";
const canonical = new URL("/about/", Astro.site!).href;
---

<Layout {title} {description} {canonical} siteName="Codec64">
  <CodecApp page="about" client:load />
</Layout>
