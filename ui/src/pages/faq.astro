---
import { CodecApp } from "../components/pages/CodecApp";
import Layout from "../layouts/Layout.astro";

const title = "Encoding and Conversion FAQ | Codec64";
const description =
  "Answers about Base64, URL encoding, query strings, JWT decoding, Python-to-JSON conversion, and Unix timestamps.";
const canonical = new URL("/faq/", Astro.site!).href;
---

<Layout {title} {description} {canonical} siteName="Codec64">
  <CodecApp page="faq" client:load />
</Layout>
