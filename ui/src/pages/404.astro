---
import { BrandLogo } from "../components/ui/BrandLogo";
import Layout from "../layouts/Layout.astro";

const title = "Page Not Found | Codec64";
const description = "The requested Codec64 page could not be found.";
---

<Layout {title} {description} siteName="Codec64" robots="noindex">
  <main data-testid="not-found-page" class="flex min-h-dvh items-center justify-center p-4 md:p-8">
    <section data-testid="not-found-section" class="w-full max-w-xl">
      <a
        data-testid="not-found-brand-link"
        href="/"
        class="font-display text-ink focus-visible:outline-primary text-section-title inline-flex min-h-11 items-center gap-2 font-bold focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4"
        ><BrandLogo /><span>Codec</span><span class="text-accent-strong">64</span></a
      >
      <h1 class="font-display text-ink text-page-title mt-8 font-bold tracking-normal text-balance">
        <span class="text-accent text-meta block font-mono font-semibold">Error 404</span>
        <span class="mt-3 block">Page not found</span>
      </h1>
      <p class="text-muted text-body max-w-reading mt-4">
        This page could not be found. Requested address does not match any Codec64 tool.
      </p>
      <a
        data-testid="not-found-home"
        href="/"
        class="bg-primary text-paper hover:bg-primary-strong focus-visible:outline-primary rounded-control mt-8 inline-flex min-h-11 items-center justify-center px-5 py-2.5 font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
        >Back to Codec64</a
      >
    </section>
  </main>
</Layout>
