---
import { CodecApp } from "../components/pages/CodecApp";
import Layout from "../layouts/Layout.astro";

const title = "Privacy & Cookies Policy | Codec64";
const description = "How Codec64 uses Google Analytics cookies, what data is collected, and how to withdraw consent.";
const canonical = new URL("/privacy/", Astro.site!).href;
---

<Layout {title} {description} {canonical} siteName="Codec64">
  <CodecApp page="privacy" client:load />
</Layout>
