---
import Layout from "../../layouts/Layout.astro";
import { getTool, type ToolId } from "../../lib/tools";
import { CodecApp } from "./CodecApp";

interface Props {
  toolId: ToolId;
}
const { toolId } = Astro.props;
const tool = getTool(toolId);
const description = tool.metaDescription;
const canonical = new URL(tool.route, Astro.site!).href;
const title = `${tool.title} | Codec64`;
const webApplication = {
  "@type": "WebApplication",
  name: toolId === "base64" ? "Codec64 Base64 Encoder and Decoder" : `Codec64 ${tool.label}`,
  url: canonical,
  description,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Any",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
// The Base64 page also describes the site itself; one script keeps a single JSON-LD block per page.
const structuredData =
  toolId === "base64"
    ? {
        "@context": "https://schema.org",
        "@graph": [{ "@type": "WebSite", name: "Codec64", url: new URL("/", Astro.site!).href }, webApplication],
      }
    : { "@context": "https://schema.org", ...webApplication };
---

<Layout {title} {description} {canonical} siteName="Codec64" {structuredData}>
  <noscript>Enable JavaScript to use conversions.</noscript>
  <CodecApp toolId={tool.id} client:load />
</Layout>
