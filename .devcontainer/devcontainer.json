{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/refs/heads/main/schemas/devContainer.base.schema.json",
  // "name": "saicli",
  "dockerComposeFile": [
    // "../compose.yaml",  // if uncommenting: replace .. with . in ./compose.devcontainer.yaml
    "./compose.devcontainer.yaml",
    "/media/IDATA_LINUX/GIT/LOCAL/ai_cli/devcontainer/src/compose.common.yaml",
    "/media/IDATA_LINUX/GIT/LOCAL/ai_cli/devcontainer/src/compose.gui.yaml"
    // "/media/IDATA_LINUX/GIT/LOCAL/ai_cli/devcontainer/src/compose.audio.yaml",
  ],
  "service": "devcontainer", // devcontainer service to work on
  "runServices": ["devcontainer"], // services to start ([] = start all defined in dockerComposeFile)
  "updateRemoteUserUID": false, // remote user already has same host UID/GID
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}"
  },
  "workspaceFolder": "/workspaces/project", // cwd after create

  // "initializeCommand": "${localWorkspaceFolder}/.devcontainer/_host_start.sh", on HOST, every start
  // "postCreateCommand": "${containerWorkspaceFolder}/.devcontainer/_post_create.sh",
  // "postStartCommand": "${containerWorkspaceFolder}/.devcontainer/_post_start.sh",
  "postAttachCommand": "${containerWorkspaceFolder}/.devcontainer/_entrypoint.sh"
}
