# Copy this file to .devcontainer/.env. Change external ports when another host app uses them.
UI_EXT_PORT=3000
API_EXT_PORT=8000

# Ports inside the devcontainer; UI test preview uses its own port.
UI_INT_PORT=3000
UI_TEST_INT_PORT=3001
API_INT_PORT=8000
API_TEST_INT_PORT=8001

# Disable Astro telemetry in this workspace.
ASTRO_TELEMETRY_DISABLED=1
